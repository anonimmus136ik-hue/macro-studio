{
  "schemaVersion": 1,
  "id": "macrostudio",
  "version": "${version}",
  "name": "Macro Studio MAX — Obsidian Edition",
  "description": "Premium client-side utility interface: macros, 3D selection preview, assisted mining routes and configurable visual HUD.",
  "authors": [
    "Macro Studio Contributors"
  ],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.macrostudio.MacroStudioMod"
    ]
  },
  "mixins": [
    {
      "config": "macrostudio.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.18.0",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  },
  "icon": "assets/macrostudio/icon.png",
  "contributors": [
    "anonimmus136ik-hue"
  ]
}
