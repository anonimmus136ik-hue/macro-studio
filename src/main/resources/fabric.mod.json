{
  "schemaVersion": 1,
  "id": "macrostudio",
  "version": "${version}",
  "name": "Macro Studio MAX 2.3",
  "description": "3D red/green mining selection on key 0, assisted top-down mining, safe preview and scrollable GUI.",
  "authors": [
    "Claude"
  ],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.macrostudio.MacroStudioMod"
    ]
  },
  "mixins": [
    {
      "config": "macrostudio.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.18.0",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  }
}
